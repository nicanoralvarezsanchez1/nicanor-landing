# Supabase (proyecto propio de Nicanor). Sin estas variables, en desarrollo los
# contactos se guardan en memoria y se muestran en la consola.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Meta: ID del píxel (conjunto de datos) de Nicanor y token de la API de Conversiones.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional: código de "Probar eventos" del Administrador de eventos. Quitarlo al terminar las pruebas.
META_TEST_EVENT_CODE=

# Contraseña del panel /admin.
ADMIN_PASSWORD=

# Datos públicos de Nicanor.
NEXT_PUBLIC_WHATSAPP_NUMBER=51933643720
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/nicanoralvarezsanchez1/psicoterapia
# Valor que se informa a Meta cuando un contacto pasa a "paciente" (soles).
PURCHASE_VALUE_PEN=600
